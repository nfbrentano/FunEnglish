{
  "slug": "present-perfect-or-past-simple",
  "title": "Present Perfect or Past Simple?",
  "description": "Choose the right tense. Each answer explains the time word that decides it.",
  "category": "grammar",
  "type": "quiz",
  "levelMin": "intermediate",
  "levelMax": "intermediate",
  "tags": ["present perfect", "past simple", "tenses", "verbs"],
  "status": "published",
  "thumbnail": {
    "src": "/images/activities/present-perfect-or-past-simple/thumb.webp",
    "alt": "A calendar with some days crossed out and an arrow pointing to today",
    "source": "ai"
  },
  "content": {
    "questions": [
      {
        "prompt": "I ___ to London last summer.",
        "options": [
          {
            "text": "went",
            "correct": true
          },
          {
            "text": "have gone"
          },
          {
            "text": "have been going"
          }
        ],
        "explanation": "\"Last summer\" is a finished time, so we use the past simple."
      },
      {
        "prompt": "She ___ three emails so far today.",
        "options": [
          {
            "text": "has written",
            "correct": true
          },
          {
            "text": "wrote"
          },
          {
            "text": "writes"
          }
        ],
        "explanation": "\"So far today\" means the time isn't finished yet: use the present perfect."
      },
      {
        "prompt": "___ you ever ___ sushi?",
        "options": [
          {
            "text": "Have … eaten",
            "correct": true
          },
          {
            "text": "Did … eat"
          },
          {
            "text": "Have … ate"
          }
        ],
        "explanation": "Use \"ever\" with the present perfect to ask about life experiences."
      },
      {
        "prompt": "We ___ each other since 2015.",
        "options": [
          {
            "text": "have known",
            "correct": true
          },
          {
            "text": "knew"
          },
          {
            "text": "know"
          }
        ],
        "explanation": "\"Since\" + a starting point goes with the present perfect."
      },
      {
        "prompt": "When ___ you ___ your new job?",
        "options": [
          {
            "text": "did … start",
            "correct": true
          },
          {
            "text": "have … started"
          },
          {
            "text": "do … started"
          }
        ],
        "explanation": "Questions with \"when\" ask about a specific past time: use the past simple."
      },
      {
        "prompt": "My grandfather ___ in 1998.",
        "options": [
          {
            "text": "died",
            "correct": true
          },
          {
            "text": "has died"
          },
          {
            "text": "have died"
          }
        ],
        "explanation": "A specific year in the past needs the past simple."
      },
      {
        "prompt": "I ___ here for two years, and I still love it.",
        "options": [
          {
            "text": "have lived",
            "correct": true
          },
          {
            "text": "lived"
          },
          {
            "text": "am live"
          }
        ],
        "explanation": "\"For two years\" up to now, and still true: present perfect."
      },
      {
        "prompt": "Yesterday I ___ my homework and then I ___ to bed.",
        "options": [
          {
            "text": "did / went",
            "correct": true
          },
          {
            "text": "have done / have gone"
          },
          {
            "text": "did / have gone"
          }
        ],
        "explanation": "\"Yesterday\" is finished time, so both verbs are in the past simple."
      }
    ]
  }
}

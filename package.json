{
  "name": "fun-english",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "rm -rf .next/cache/fetch-cache && next build",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "emulators": "firebase emulators:start --project demo-fun-english",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "seed": "tsx scripts/seed.ts",
    "seed:check": "tsx scripts/seed.ts --dry-run",
    "seed:emulator": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_PROJECT_ID=demo-fun-english tsx scripts/seed.ts",
    "content:pull": "tsx scripts/content-pull.ts",
    "content:pull:emulator": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_PROJECT_ID=demo-fun-english tsx scripts/content-pull.ts",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-fun-english \"vitest run --config vitest.emulator.config.mts\"",
    "preview": "firebase emulators:start --only hosting --project demo-fun-english",
    "deploy": "npm run build && firebase deploy --only hosting",
    "content:check-videos": "tsx scripts/check-videos.ts",
    "images:import": "tsx scripts/import-images.ts",
    "images:migrate-prompts": "tsx scripts/migrate-image-prompts.ts",
    "set-admin": "tsx scripts/set-admin.ts"
  },
  "dependencies": {
    "@next/env": "^16.3.8",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.49.0",
    "marked": "^16.4.2",
    "next": "16.3.8",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "firebase-tools": "^15.32.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}

# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Public site URL (canonical links, sitemap, share links). No trailing slash.
# Leave empty on Vercel to use the production *.vercel.app domain automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase web app config (Firebase console > Project settings > Your apps > Web app).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Local development against the Firebase Emulator Suite (npm run emulators).
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# Server-only: Admin SDK service account, as single-line JSON.
# Firebase console > Project settings > Service accounts > Generate new private key.
FIREBASE_SERVICE_ACCOUNT_KEY=

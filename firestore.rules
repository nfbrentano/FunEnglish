rules_version = '2';

// Anything not matched below is denied. Each feature spec opens only the access it needs.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Catalog: anyone reads published activities (queries must filter status == "published");
    // only admins read drafts and write.
    match /activities/{activityId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow write: if isAdmin();

      // Version history (spec: gestão completa, RF11): admins only, even for published ones.
      match /revisions/{revisionId} {
        allow read, write: if isAdmin();
      }
    }

    // Teacher profiles: only the owner reads and writes; the role can't be changed by the client.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.role == "teacher"
        && request.resource.data.keys().hasOnly(["displayName", "email", "photoURL", "role", "createdAt"]);
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;
      allow delete: if false;

      // Favorites and lists: private to their owner (spec: favoritos, RNF01).
      match /favorites/{activityId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(["addedAt", "listIds"])
          && request.resource.data.listIds is list
          && request.resource.data.listIds.size() <= 50;
      }
      match /history/{activityId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(["lastPlayedAt"]);
      }
      match /lists/{listId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(["name", "order", "createdAt"])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60;
      }
      // Classes (spec: turmas e alunos, RF01, RF02, RNF01): private to teacher.
      match /classes/{classId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(["name", "studentIds", "archived", "createdAt"])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.studentIds is list
          && request.resource.data.studentIds.size() <= 60
          && request.resource.data.archived is bool;
      }
    }

    // Students (spec: turmas e alunos, RNF01, RNF02, CA07):
    // Root collection so student portal can read later; currently only the teacherUid can read and write.
    match /students/{studentId} {
      allow read, delete: if request.auth != null && resource.data.teacherUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.keys().hasOnly(["teacherUid", "name", "email", "classIds", "portalUid", "homeworkPin", "createdAt"])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.classIds is list
        && request.resource.data.classIds.size() <= 20
        && request.resource.data.homeworkPin is string
        && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 254 && request.resource.data.email.matches("^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$")))
        && (!('portalUid' in request.resource.data) || request.resource.data.portalUid is string);
      allow update: if request.auth != null
        && resource.data.teacherUid == request.auth.uid
        && request.resource.data.teacherUid == resource.data.teacherUid
        && request.resource.data.keys().hasOnly(["teacherUid", "name", "email", "classIds", "portalUid", "homeworkPin", "createdAt"])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.classIds is list
        && request.resource.data.classIds.size() <= 20
        && request.resource.data.homeworkPin is string
        && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 254 && request.resource.data.email.matches("^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$")))
        && (!('portalUid' in request.resource.data) || request.resource.data.portalUid is string);

      // Student subcollections (grades, vocabulary, progress, etc.) are private to teacher
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && get(/databases/$(database)/documents/students/$(studentId)).data.teacherUid == request.auth.uid;
      }
    }

    // Contact form (spec: páginas institucionais, RNF01): anyone can send, nobody reads from the
    // client. Messages are read in the Firebase console.
    match /contactMessages/{id} {
      allow create: if request.resource.data.keys().hasOnly(["name", "email", "subject", "message", "createdAt"])
        && request.resource.data.keys().hasAll(["name", "email", "subject", "message", "createdAt"])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches("^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$")
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0 && request.resource.data.subject.size() <= 150
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 2000
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // Aggregated catalog (catalog/index): public read, written by the seed and the admin panel.
    match /catalog/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

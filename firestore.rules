rules_version = '2';

// Anything not matched below is denied. Each feature spec opens only the access it needs.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Catalog: anyone reads published activities (queries must filter status == "published");
    // only admins read drafts and write.
    match /activities/{activityId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow write: if isAdmin();
    }

    // Teacher profiles: only the owner reads and writes; the role can't be changed by the client.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.role == "teacher"
        && request.resource.data.keys().hasOnly(["displayName", "email", "photoURL", "role", "createdAt"]);
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // Aggregated catalog (catalog/index): public read, written by the seed and the admin panel.
    match /catalog/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

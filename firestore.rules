rules_version = '2';

// Anything not matched below is denied. Each feature spec opens only the access it needs.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Catalog: anyone reads published activities (queries must filter status == "published");
    // only admins read drafts and write.
    match /activities/{activityId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow write: if isAdmin();

      // Version history (spec: gestão completa, RF11): admins only, even for published ones.
      match /revisions/{revisionId} {
        allow read, write: if isAdmin();
      }
    }

    // Teacher and Student profiles: only the owner reads and writes; the role can't be changed by the client.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.role in ["teacher", "student"]
        && request.resource.data.keys().hasOnly(["displayName", "email", "photoURL", "role", "createdAt"]);
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;
      allow delete: if false;

      // Favorites and lists: private to their owner (spec: favoritos, RNF01).
      match /favorites/{activityId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(["addedAt", "listIds"])
          && request.resource.data.listIds is list
          && request.resource.data.listIds.size() <= 50;
      }
      match /history/{activityId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(["lastPlayedAt"]);
      }
      match /lists/{listId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(["name", "order", "createdAt"])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60;
      }
      // Classes (spec: turmas e alunos, RF01, RF02, RNF01): private to teacher.
      match /classes/{classId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(["name", "studentIds", "archived", "createdAt"])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.studentIds is list
          && request.resource.data.studentIds.size() <= 60
          && request.resource.data.archived is bool;
      }
      // Classroom sessions (spec: sessão de aula, RF01, RF08, RNF01): private to teacher.
      match /sessions/{sessionId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == uid;
      }
      // Tracks (spec: trilha de progresso visual, RF01, RF02, RNF01): private to teacher.
      match /tracks/{trackId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.activityIds is list
          && request.resource.data.activityIds.size() >= 1
          && request.resource.data.activityIds.size() <= 30
          && (!('description' in request.resource.data) || (request.resource.data.description is string && request.resource.data.description.size() <= 300))
          && (!('level' in request.resource.data) || request.resource.data.level is string)
          && (!('countClassActivities' in request.resource.data) || request.resource.data.countClassActivities is bool)
          && (!('assignedStudentIds' in request.resource.data) || (request.resource.data.assignedStudentIds is list && request.resource.data.assignedStudentIds.size() <= 500))
          && (!('assignedClassIds' in request.resource.data) || (request.resource.data.assignedClassIds is list && request.resource.data.assignedClassIds.size() <= 100));
      }
      // Lessons (spec: agenda de aulas individuais, RNF04): private to teacher, but students can read their own.
      match /lessons/{lessonId} {
        allow read: if request.auth != null && (
          request.auth.uid == uid ||
          (resource == null) ||
          (resource.data.studentId != null && get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.portalUid == request.auth.uid)
        );
        allow write: if request.auth != null && request.auth.uid == uid;
      }
      // Availability settings (spec: agendamento, CA02): teacher manages, students read.
      match /availability/settings {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Students (spec: turmas e alunos, portal do aluno, RNF01, RNF02, RNF03, CA07, CA09):
    // Root collection: teacher reads/writes, student reads when portalUid matches auth.uid.
    match /students/{studentId} {
      allow read: if request.auth != null && (
        resource.data.teacherUid == request.auth.uid ||
        resource.data.portalUid == request.auth.uid
      );
      allow delete: if request.auth != null && resource.data.teacherUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.keys().hasOnly(["teacherUid", "name", "email", "classIds", "portalUid", "homeworkPin", "createdAt"])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.classIds is list
        && request.resource.data.classIds.size() <= 20
        && request.resource.data.homeworkPin is string
        && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 254 && request.resource.data.email.matches("^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$")))
        && (!('portalUid' in request.resource.data) || request.resource.data.portalUid is string);
      allow update: if request.auth != null
        && resource.data.teacherUid == request.auth.uid
        && request.resource.data.teacherUid == resource.data.teacherUid
        && request.resource.data.keys().hasOnly(["teacherUid", "name", "email", "classIds", "portalUid", "homeworkPin", "createdAt"])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.classIds is list
        && request.resource.data.classIds.size() <= 20
        && request.resource.data.homeworkPin is string
        && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 254 && request.resource.data.email.matches("^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$")))
        && (!('portalUid' in request.resource.data) || request.resource.data.portalUid is string);

      // Notes subcollection (spec: notas e erros do aluno, RNF01, RNF02, CA07):
      // Teacher reads and writes all notes.
      // Student portalUid reads only shared notes.
      match /notes/{noteId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/students/$(studentId)).data.teacherUid == request.auth.uid ||
          (
            resource.data.visibility == "shared" &&
            get(/databases/$(database)/documents/students/$(studentId)).data.portalUid == request.auth.uid
          )
        );
        allow create: if request.auth != null
          && get(/databases/$(database)/documents/students/$(studentId)).data.teacherUid == request.auth.uid
          && request.resource.data.keys().hasAll(["category", "text", "visibility", "resolved", "createdAt", "updatedAt"])
          && request.resource.data.category in ["pronunciation", "grammar", "vocabulary", "fluency", "strength", "general"]
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.visibility in ["private", "shared"]
          && request.resource.data.resolved is bool
          && (!('correction' in request.resource.data) || (request.resource.data.correction is string && request.resource.data.correction.size() <= 500))
          && (!('sessionId' in request.resource.data) || (request.resource.data.sessionId is string && request.resource.data.sessionId.size() <= 100));
        allow update: if request.auth != null
          && get(/databases/$(database)/documents/students/$(studentId)).data.teacherUid == request.auth.uid
          && request.resource.data.category in ["pronunciation", "grammar", "vocabulary", "fluency", "strength", "general"]
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.visibility in ["private", "shared"]
          && request.resource.data.resolved is bool
          && (!('correction' in request.resource.data) || (request.resource.data.correction is string && request.resource.data.correction.size() <= 500))
          && (!('sessionId' in request.resource.data) || (request.resource.data.sessionId is string && request.resource.data.sessionId.size() <= 100));
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/students/$(studentId)).data.teacherUid == request.auth.uid;
      }

      // Session / class history for the student (spec: portal do aluno, RF05, CA04):
      // Teacher reads and writes; student reads if portalUid matches.
      match /classes/{sessionId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/students/$(studentId)).data.teacherUid == request.auth.uid ||
          get(/databases/$(database)/documents/students/$(studentId)).data.portalUid == request.auth.uid
        );
        allow write: if request.auth != null &&
          get(/databases/$(database)/documents/students/$(studentId)).data.teacherUid == request.auth.uid;
      }

      // Vocabulary subcollection (spec: banco de vocabulário do aluno, RNF01, RNF02, CA08):
      // Teacher reads and writes all fields.
      // Student (portalUid) reads words, and updates ONLY `learned`.
      match /vocabulary/{wordId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/students/$(studentId)).data.teacherUid == request.auth.uid ||
          get(/databases/$(database)/documents/students/$(studentId)).data.portalUid == request.auth.uid
        );
        allow create: if request.auth != null
          && get(/databases/$(database)/documents/students/$(studentId)).data.teacherUid == request.auth.uid
          && request.resource.data.term is string
          && request.resource.data.term.size() > 0
          && request.resource.data.term.size() <= 80
          && request.resource.data.learned is bool
          && request.resource.data.sessionIds is list
          && request.resource.data.sessionIds.size() <= 50
          && (!('meaning' in request.resource.data) || (request.resource.data.meaning is string && request.resource.data.meaning.size() <= 200))
          && (!('example' in request.resource.data) || (request.resource.data.example is string && request.resource.data.example.size() <= 200));
        allow update: if request.auth != null && (
          (
            get(/databases/$(database)/documents/students/$(studentId)).data.teacherUid == request.auth.uid
            && request.resource.data.term is string
            && request.resource.data.term.size() > 0
            && request.resource.data.term.size() <= 80
            && request.resource.data.learned is bool
            && request.resource.data.sessionIds is list
            && request.resource.data.sessionIds.size() <= 50
            && (!('meaning' in request.resource.data) || (request.resource.data.meaning is string && request.resource.data.meaning.size() <= 200))
            && (!('example' in request.resource.data) || (request.resource.data.example is string && request.resource.data.example.size() <= 200))
          ) ||
          (
            get(/databases/$(database)/documents/students/$(studentId)).data.portalUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["learned"])
            && request.resource.data.learned is bool
          )
        );
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/students/$(studentId)).data.teacherUid == request.auth.uid;
      }

      // Homework submissions for student (spec: tarefa de casa, RF09, CA05):
      // Teacher reads; student reads if portalUid matches auth.uid.
      match /homeworkSubmissions/{submissionId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/students/$(studentId)).data.teacherUid == request.auth.uid ||
          get(/databases/$(database)/documents/students/$(studentId)).data.portalUid == request.auth.uid
        );
        allow write: if false;
      }

      // Progress tracks for student (spec: trilha de progresso visual, RF03, RF05, RNF01, RNF03, CA09):
      // Teacher reads and writes; student reads if portalUid matches auth.uid; student writing is denied.
      match /tracks/{trackId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/students/$(studentId)).data.teacherUid == request.auth.uid ||
          get(/databases/$(database)/documents/students/$(studentId)).data.portalUid == request.auth.uid
        );
        allow write: if request.auth != null &&
          get(/databases/$(database)/documents/students/$(studentId)).data.teacherUid == request.auth.uid;
      }

      // Schedule rules for student (spec: agendamento, CA01):
      // Teacher reads and writes; student reads if portalUid matches auth.uid.
      match /schedule/{ruleId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/students/$(studentId)).data.teacherUid == request.auth.uid ||
          get(/databases/$(database)/documents/students/$(studentId)).data.portalUid == request.auth.uid
        );
        allow write: if request.auth != null &&
          get(/databases/$(database)/documents/students/$(studentId)).data.teacherUid == request.auth.uid;
      }

      // Other student subcollections (grades, progress, etc.) are private to teacher
      match /{subcollection}/{document=**} {
        allow read, write: if subcollection != "notes" && subcollection != "classes" && subcollection != "vocabulary" && subcollection != "homeworkSubmissions" && subcollection != "tracks" && subcollection != "schedule" && request.auth != null && get(/databases/$(database)/documents/students/$(studentId)).data.teacherUid == request.auth.uid;
      }
    }

    // Student portal invites: read and written only via Cloud Functions (RNF02, CA09)
    match /invites/{code} {
      allow read, write: if false;
    }

    // Homework (spec: tarefa de casa, RF01, RF06, RNF01, RNF07, CA09):
    match /homework/{homeworkId} {
      // Anyone with ID can read the homework doc (get), but cannot list the collection (RNF01, CA09)
      allow get: if true;
      allow list: if request.auth != null && resource.data.teacherUid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.teacherUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.teacherUid == request.auth.uid;

      // Assignees subcollection: handled only via Cloud Functions (RNF07)
      match /assignees/{token} {
        allow read, write: if false;
      }

      // Submissions subcollection: read only by the owner teacher; writes solely via submitHomework Cloud Function (RNF01, CA09)
      match /submissions/{submissionId} {
        allow read: if request.auth != null &&
          get(/databases/$(database)/documents/homework/$(homeworkId)).data.teacherUid == request.auth.uid;
        allow write: if false;
      }
    }

    // PIN brute-force attempt tracking: managed by Cloud Functions, read by teacher
    match /pinAttempts/{studentId} {
      allow read: if request.auth != null && resource.data.teacherUid == request.auth.uid;
      allow write: if false;
    }


    // Contact form (spec: páginas institucionais, RNF01): anyone can send, nobody reads from the
    // client. Messages are read in the Firebase console.
    match /contactMessages/{id} {
      allow create: if request.resource.data.keys().hasOnly(["name", "email", "subject", "message", "createdAt"])
        && request.resource.data.keys().hasAll(["name", "email", "subject", "message", "createdAt"])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches("^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$")
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0 && request.resource.data.subject.size() <= 150
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 2000
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // Aggregated catalog (catalog/index): public read, written by the seed and the admin panel.
    match /catalog/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
